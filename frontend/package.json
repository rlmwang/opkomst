    "vue-router": "^5.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^22.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/test-utils": "^2.4.9",
    "happy-dom": "^20.9.0",
    "openapi-typescript": "^7.13.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^7.3.6",
